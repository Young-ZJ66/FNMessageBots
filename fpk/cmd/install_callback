#!/bin/bash

### Called after the user installs the application.
### Docker 版：仅初始化持久化目录与默认配置，不安装 Python/venv。

set -euo pipefail

fail_user_visible() {
  local msg="$1"
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf "%s\n" "${msg}" > "${TRIM_TEMP_LOGFILE}"
  fi
  exit 1
}

_INSTALL_FAIL_DOCKER_HINT="请到 GitHub 仓库查看安装文档：https://github.com/Young-ZJ66/FNMessageBots"

if [ -z "${TRIM_PKGVAR:-}" ]; then
  fail_user_visible "安装失败：未设置 TRIM_PKGVAR。${_INSTALL_FAIL_DOCKER_HINT}"
fi

mkdir -p "${TRIM_PKGVAR}/config" "${TRIM_PKGVAR}/data/logs" "${TRIM_PKGVAR}/data/cursor"

if ! touch "${TRIM_PKGVAR}/.fnmb_wtest" 2>/dev/null; then
  fail_user_visible "安装失败：无法在数据目录写入（${TRIM_PKGVAR}）。${_INSTALL_FAIL_DOCKER_HINT}"
fi
rm -f "${TRIM_PKGVAR}/.fnmb_wtest"

# 默认配置：优先 TRIM_APPDEST/docker/config，其次相对安装根目录
_resolve_default_config() {
  local candidates=()
  if [ -n "${TRIM_APPDEST:-}" ]; then
    candidates+=("${TRIM_APPDEST}/docker/config/config.json")
  fi
  local root
  root="$(cd -P "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
  candidates+=("${root}/app/docker/config/config.json")
  candidates+=("${root}/target/docker/config/config.json")

  local c
  for c in "${candidates[@]}"; do
    if [ -f "${c}" ]; then
      printf "%s" "${c}"
      return 0
    fi
  done
  return 1
}

if [ ! -f "${TRIM_PKGVAR}/config/config.json" ]; then
  if ! DEFAULT_CONFIG="$(_resolve_default_config)"; then
    fail_user_visible "安装失败：未找到默认配置 config.json。${_INSTALL_FAIL_DOCKER_HINT}"
  fi
  cp -f "${DEFAULT_CONFIG}" "${TRIM_PKGVAR}/config/config.json"
fi

# 安装向导设置的访问密码：只写入 PBKDF2 盐值与哈希（与 web/auth_service.py 一致），
# 明文不落盘、不输出。未经向导（变量为空）时跳过，应用启动后走初始化码流程。
# 注：向导不含端口项——Docker 型的服务端口由 manifest 的 service_port(18230) 与
# 桌面入口共同固定，改端口需在 compose 与入口两侧同步修改。
if [ -n "${wizard_web_password:-}" ]; then
  set +e
  FNMB_PW="${wizard_web_password}" \
  FNMB_PW2="${wizard_web_password_confirm:-}" \
  FNMB_CFG="${TRIM_PKGVAR}/config/config.json" \
  python3 - <<'PY'
import hashlib
import json
import os
import secrets
import sys
import tempfile

pw = os.environ["FNMB_PW"].strip()
if len(pw) < 8:
    sys.exit(2)
if pw != os.environ.get("FNMB_PW2", "").strip():
    sys.exit(3)
cfg = os.environ["FNMB_CFG"]
with open(cfg, encoding="utf-8") as f:
    data = json.load(f)
salt = secrets.token_hex(16)
data["web_password_salt"] = salt
data["web_password_hash"] = hashlib.pbkdf2_hmac("sha256", pw.encode("utf-8"), bytes.fromhex(salt), 100000).hex()
data.pop("web_password_enabled", None)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(cfg))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, cfg)
PY
  _pw_rc=$?
  set -e
  case "${_pw_rc}" in
    0) rm -f "${TRIM_PKGVAR}/config/.setup_code" ;;
    2) fail_user_visible "安装失败：访问密码长度至少 8 位。" ;;
    3) fail_user_visible "安装失败：两次输入的访问密码不一致。" ;;
    *) fail_user_visible "安装失败：写入访问密码失败（${TRIM_PKGVAR}/config/config.json）。" ;;
  esac
fi
chmod 600 "${TRIM_PKGVAR}/config/config.json" 2>/dev/null || true

# 按宿主实况把可选挂载写入主 docker-compose.yaml（不依赖 override）
# shellcheck source=lib_vol_override.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lib_vol_override.sh"
fnmb_write_compose_override || true

exit 0
